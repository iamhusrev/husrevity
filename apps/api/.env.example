# apps/api/.env — copy to .env (gitignored) and fill secrets.
# Generate:
#   openssl rand -base64 48   # HUSREVITY_JWT_SECRET (>= 32 bytes)
#   openssl rand -base64 32   # HUSREVITY_CRYPTO_KEY (32 bytes for AES-GCM)

NODE_ENV=development
HUSREVITY_PORT=4090

# Postgres (shared-infra container on :5432)
HUSREVITY_DB_HOST=localhost
HUSREVITY_DB_PORT=5432
HUSREVITY_DB_NAME=husrevity_nest
HUSREVITY_DB_USER=postgres
HUSREVITY_DB_PASSWORD=postgres

# Auth
HUSREVITY_JWT_SECRET=replace-with-openssl-rand-base64-48-bytes-minimum-32-required
HUSREVITY_JWT_ACCESS_TTL_MIN=10080
HUSREVITY_JWT_REFRESH_TTL_DAYS=30
HUSREVITY_JWT_ISSUER=husrevity-nest

# Crypto (AES-GCM, base64 of 32 bytes)
HUSREVITY_CRYPTO_KEY=replace-with-openssl-rand-base64-32

# CORS — comma-separated origins (Next dev: 3000, prod start: 3090)
HUSREVITY_CORS_ORIGINS=http://localhost:3090,http://localhost:3000

# Web app base URL — used in notification e-mails / invite links.
HUSREVITY_WEB_URL=http://localhost:3090

# AI suggestions ("what should I do today?") — Gemini (Generative Language API,
# API key). Also used by the sport AI program generator. Optional: blank
# disables the feature (endpoint returns 400). Get a key: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Web Push (VAPID) — required for the notification system. Generate once with:
#   cd apps/api && bunx web-push generate-vapid-keys
# Leave blank to disable push (in-app bell still works, but no OS notifications).
# VAPID_SUBJECT must be a mailto: or https: URL identifying the app owner.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:iamhusrev@gmail.com

# Email channel (Gmail SMTP via app password). Optional — blank disables the
# email leg; in-app bell + web-push keep working. Generate an app password at
# https://myaccount.google.com/apppasswords (requires 2FA on the Gmail account).
# Without MAIL_USER+MAIL_PASS the dispatcher just logs a warning at boot.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Husrevity <iamhusrev@gmail.com>
MAIL_REPLY_TO=iamhusrev@gmail.com
