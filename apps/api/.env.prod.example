# apps/api/.env.prod.example — copy to apps/api/.env.prod (gitignored) on the
# prod host, then edit. The compose file mounts this as `env_file` for the api
# service AND uses `${VAR}` interpolation for postgres credentials.
#
# Generate strong secrets:
#   openssl rand -base64 48   # HUSREVITY_JWT_SECRET (>= 32 bytes)
#   openssl rand -base64 32   # HUSREVITY_CRYPTO_KEY (32 bytes for AES-GCM)
#
# CRITICAL: HUSREVITY_CRYPTO_KEY is IMMUTABLE in prod — rotation = vault data
# loss. See ~/iamhusrev-prod/RUNBOOK.md before touching it.
#
# Recommended location: keep the canonical copy at ~/iamhusrev-prod/secrets/husrevity.env (chmod
# 600), and symlink:
#   ln -s ~/iamhusrev-prod/secrets/husrevity.env apps/api/.env.prod

NODE_ENV=production
HUSREVITY_PORT=4090

# Postgres (compose service name = "postgres" inside the husrevity-prod network)
HUSREVITY_DB_HOST=postgres
HUSREVITY_DB_PORT=5432
HUSREVITY_DB_NAME=husrevity_prod
HUSREVITY_DB_USER=postgres
HUSREVITY_DB_PASSWORD=replace-with-strong-password

# Auth
HUSREVITY_JWT_SECRET=replace-with-openssl-rand-base64-48-bytes-minimum-32-required
HUSREVITY_JWT_ACCESS_TTL_MIN=15
HUSREVITY_JWT_REFRESH_TTL_DAYS=30
HUSREVITY_JWT_ISSUER=husrevity-prod

# AES-GCM (IMMUTABLE — see ~/iamhusrev-prod/RUNBOOK.md)
HUSREVITY_CRYPTO_KEY=replace-with-openssl-rand-base64-32

# CORS — comma-separated origins (prod web only)
HUSREVITY_CORS_ORIGINS=https://app.iamhusrev.com

# Web app base URL — the Gmail OAuth callback 302-redirects the browser here.
HUSREVITY_WEB_URL=https://app.iamhusrev.com

# First-deploy admin: after migrations, run from the api container:
#   bun run seed:admin <your-email> <strong-password> <FirstName> <LastName>
# The script upserts (idempotent), so re-running it just resets the password.

# Google OAuth (Gmail integration). Optional — leave blank to disable Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.iamhusrev.com/api/gmail/oauth/callback
GOOGLE_MOBILE_REDIRECT_URI=husrevity://oauth/callback
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/contacts.readonly https://www.googleapis.com/auth/drive.readonly openid email profile

# Microsoft (Outlook) OAuth — Azure app registration. Same backend callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.iamhusrev.com/api/gmail/oauth/callback
MICROSOFT_OAUTH_SCOPE=offline_access User.Read Mail.ReadWrite Mail.Send Calendars.Read Contacts.Read
MICROSOFT_TENANT=common

# AI chatbot — Gemini (Generative Language API, API key).
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Web Push (VAPID) — required for notification system. Generate once with:
#   cd apps/api && bunx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is IMMUTABLE in prod — rotating invalidates every device
# subscription and users must re-enable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:iamhusrev@gmail.com

# Email channel (Gmail SMTP via app password). Optional. App password at:
# https://myaccount.google.com/apppasswords (2FA required on the Gmail account).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Husrevity <iamhusrev@gmail.com>
MAIL_REPLY_TO=iamhusrev@gmail.com
