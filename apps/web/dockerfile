# Build context expected: monorepo root.
# Build: `docker compose build web`

# ---- Builder ----
FROM oven/bun:1.3 AS builder
WORKDIR /repo

COPY package.json bun.lock tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY packages/parser/package.json ./packages/parser/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json

# Registry downloads occasionally fail on the runner ("Fail extracting tarball"); retry a few times.
RUN for i in 1 2 3; do bun install --frozen-lockfile --filter '@husrevity/web' && exit 0; echo "bun install failed (attempt $i), retrying"; sleep 5; done; exit 1

COPY apps/web ./apps/web

# NEXT_PUBLIC_* must exist at build time so Next.js inlines them into the client bundle.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN cd apps/web && bun run build

# ---- Runner ----
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3090
ENV HOSTNAME=0.0.0.0

# Next.js standalone bundles a minimal node_modules. The output preserves the
# monorepo path, so server.js lives at apps/web/server.js inside the image.
COPY --from=builder /repo/apps/web/.next/standalone ./
COPY --from=builder /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /repo/apps/web/public ./apps/web/public

EXPOSE 3090

CMD ["node", "apps/web/server.js"]
