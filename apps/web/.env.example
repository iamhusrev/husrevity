# NestJS API (apps/api) on port 4090 with /api context path.
# This is what api-client.ts (axios) uses as baseURL.
NEXT_PUBLIC_API_URL=http://localhost:4090/api

# Set to 1 to register the service worker in development so web push / PWA can
# be tested locally. Off by default (dev normally unregisters the SW to avoid
# stale cached chunks). When on, hard-reload after switching NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_ENABLE_SW_DEV=1
