# Husrevity STAGING environment template.
#
# Copy to ~/.husrevity/api.staging.env (chmod 600), then symlink on demand:
#   ln -sfn ~/.husrevity/api.staging.env apps/api/.env.prod
#   ln -sfn ~/.husrevity/api.staging.env .env
# (the staging deploy workflow does this automatically before each deploy)
#
# Mode 600, owner husrev. NEVER commit a populated copy.
#
# Differences from prod (.env.production.example):
#   - STACK_NAME / host ports (3091/4091/5491 instead of 3090/4090/5490)
#   - Hostnames (staging-* instead of bare app/api)
#   - DB name (husrevity_staging)
#   - Independent JWT secret, DB password, CRYPTO_KEY (staging holds no prod data)
#   - GOOGLE_GEMINI_API_KEY can be left blank (saves quota) unless testing AI

# ============================================================
# STACK SELECTOR — read by docker-compose.yml for naming
# ============================================================
STACK_NAME=husrevity-staging
HUSREVITY_API_HOST_PORT=4091
HUSREVITY_WEB_HOST_PORT=3091
HUSREVITY_DB_HOST_PORT=5491

# ============================================================
# RUNTIME — used by the api container
# ============================================================
NODE_ENV=production
HUSREVITY_PORT=4090

# Postgres (compose service name = "postgres" inside the husrevity-staging network)
HUSREVITY_DB_HOST=postgres
HUSREVITY_DB_PORT=5432
HUSREVITY_DB_NAME=husrevity_staging
HUSREVITY_DB_USER=postgres
HUSREVITY_DB_PASSWORD=__rotate__

# ============================================================
# AUTH — independent from prod
# ============================================================
HUSREVITY_JWT_SECRET=__rotate__
HUSREVITY_JWT_ACCESS_TTL_MIN=15
HUSREVITY_JWT_REFRESH_TTL_DAYS=30
HUSREVITY_JWT_ISSUER=husrevity-staging

# ============================================================
# CRYPTO — independent from prod (staging has no real vault data)
# ============================================================
HUSREVITY_CRYPTO_KEY=__rotate__

# ============================================================
# WEB — staging URLs
# ============================================================
HUSREVITY_CORS_ORIGINS=https://staging-app.iamhusrev.com
HUSREVITY_WEB_URL=https://staging-app.iamhusrev.com
NEXT_PUBLIC_API_URL=https://staging-api.iamhusrev.com/api

# ============================================================
# FIRST-DEPLOY ADMIN SEED — same pattern as prod
# ============================================================
HUSREVITY_INITIAL_ADMIN_EMAIL=iamhusrev@gmail.com
HUSREVITY_INITIAL_ADMIN_PASSWORD_HASH=__paste_bcrypt_hash__

# ============================================================
# GOOGLE OAUTH — same callback as prod is fine for testing, or leave blank
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging-api.iamhusrev.com/api/gmail/oauth/callback
GOOGLE_MOBILE_REDIRECT_URI=husrevity://oauth/callback
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/contacts.readonly https://www.googleapis.com/auth/drive.readonly openid email profile

# ============================================================
# MICROSOFT OAUTH
# ============================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://staging-api.iamhusrev.com/api/gmail/oauth/callback
MICROSOFT_OAUTH_SCOPE=offline_access User.Read Mail.ReadWrite Mail.Send Calendars.Read Contacts.Read
MICROSOFT_TENANT=common

# ============================================================
# AI — leave blank for staging unless testing Gemini
# ============================================================
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# WEB PUSH (VAPID) — independent from prod (different keys OK for staging)
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:iamhusrev@gmail.com

# ============================================================
# EMAIL — blank disables (recommended for staging to avoid noisy sends)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Husrevity Staging <iamhusrev@gmail.com>
MAIL_REPLY_TO=iamhusrev@gmail.com

# ============================================================
# OPS
# ============================================================
WEBHOOK_URL=
ALERT_EMAIL=iamhusrev@gmail.com
NOTIFY_EMAIL_ON_OK=0
