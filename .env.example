# Root .env.example — pointer file. Each app owns its own env.
#
# Setup:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env.local
#
# Then edit apps/api/.env (DB, JWT secret, AES-GCM key, OAuth, VAPID, SMTP).
# The web app only needs NEXT_PUBLIC_API_URL.
#
# Generate secrets:
#   openssl rand -base64 48   # HUSREVITY_JWT_SECRET (>= 32 bytes)
#   openssl rand -base64 32   # HUSREVITY_CRYPTO_KEY (32 bytes for AES-GCM)
#   bunx web-push generate-vapid-keys   # VAPID push keys
#
# First admin (after migrations):
#   cd apps/api && bun run migration:run && bun run seed:admin
#   # default: admin@admin.com / admin
#   # custom:  bun run seed:admin you@example.com s3cret First Last
