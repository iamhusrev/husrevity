# Husrevity production environment template.
#
# Copy to ~/.husrevity/api.env (chmod 600), then symlink:
#   ln -s ~/.husrevity/api.env apps/api/.env.prod
#   ln -s ~/.husrevity/api.env .env
#
# Compose reads the same file both as env_file (for the api container) and via
# `${VAR}` interpolation at compose-parse time (for postgres creds).
#
# Mode 600, owner husrev. NEVER commit a populated copy. Off-machine copy at
# ~/Backup/husrevity-prod-secrets/api.env.copy (Drive-synced).
#
# Generate strong secrets (one-time):
#   openssl rand -base64 48                              # HUSREVITY_JWT_SECRET
#   openssl rand -base64 32                              # HUSREVITY_CRYPTO_KEY (IMMUTABLE)
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32   # HUSREVITY_DB_PASSWORD
#   cd apps/api && bunx web-push generate-vapid-keys     # VAPID (IMMUTABLE)

# ============================================================
# RUNTIME — used by the api container + compose interpolation
# ============================================================
NODE_ENV=production
HUSREVITY_PORT=4090

# Postgres (compose service name = "postgres" inside the husrevity-prod network)
HUSREVITY_DB_HOST=postgres
HUSREVITY_DB_PORT=5432
HUSREVITY_DB_NAME=husrevity_prod
HUSREVITY_DB_USER=postgres
HUSREVITY_DB_PASSWORD=__rotate__

# ============================================================
# AUTH
# ============================================================
HUSREVITY_JWT_SECRET=__rotate__
HUSREVITY_JWT_ACCESS_TTL_MIN=15
HUSREVITY_JWT_REFRESH_TTL_DAYS=30
HUSREVITY_JWT_ISSUER=husrevity-prod

# ============================================================
# CRYPTO — IMMUTABLE (vault data loss on rotation)
# ============================================================
HUSREVITY_CRYPTO_KEY=__rotate_once_then_never__

# ============================================================
# WEB — public URLs (must match Cloudflare Tunnel ingress)
# ============================================================
HUSREVITY_CORS_ORIGINS=https://app.iamhusrev.com
HUSREVITY_WEB_URL=https://app.iamhusrev.com
NEXT_PUBLIC_API_URL=https://api.iamhusrev.com/api

# ============================================================
# FIRST-DEPLOY ADMIN SEED — fill ONCE, remove after first login
# ============================================================
# Migration 1715000003000-RemoveDefaultAdmin reads these env vars on the first
# successful boot, creates a real admin, and removes admin@admin.com. If you
# omit these and admin@admin.com still exists, the migration THROWS by design
# (prevents silent lockout). After your first login as the real admin, delete
# these two lines.
#
# Generate hash:  cd apps/api && bun scripts/hash-password.ts 'your-pw'
HUSREVITY_INITIAL_ADMIN_EMAIL=iamhusrev@gmail.com
HUSREVITY_INITIAL_ADMIN_PASSWORD_HASH=__paste_bcrypt_hash__

# ============================================================
# GOOGLE OAUTH (Gmail integration) — optional, blank disables Gmail
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.iamhusrev.com/api/gmail/oauth/callback
GOOGLE_MOBILE_REDIRECT_URI=husrevity://oauth/callback
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/contacts.readonly https://www.googleapis.com/auth/drive.readonly openid email profile

# ============================================================
# MICROSOFT OAUTH (Outlook) — optional, blank disables
# ============================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.iamhusrev.com/api/gmail/oauth/callback
MICROSOFT_OAUTH_SCOPE=offline_access User.Read Mail.ReadWrite Mail.Send Calendars.Read Contacts.Read
MICROSOFT_TENANT=common

# ============================================================
# AI — Gemini (Generative Language API)
# ============================================================
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# WEB PUSH (VAPID) — IMMUTABLE in prod (rotation voids all subscriptions)
# ============================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:iamhusrev@gmail.com

# ============================================================
# EMAIL CHANNEL (Gmail SMTP) — optional, blank disables email notifications
# ============================================================
# App password: https://myaccount.google.com/apppasswords (2FA required).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Husrevity <iamhusrev@gmail.com>
MAIL_REPLY_TO=iamhusrev@gmail.com

# ============================================================
# OPS — notify.sh, deploy.sh, backup
# ============================================================
# Discord webhook for deploy/backup status. Leave blank to skip.
WEBHOOK_URL=
# Email recipient for FAIL alerts (uses macOS `mail`).
ALERT_EMAIL=iamhusrev@gmail.com
# Set to 1 to email on OK too (default: only on FAIL).
NOTIFY_EMAIL_ON_OK=0
