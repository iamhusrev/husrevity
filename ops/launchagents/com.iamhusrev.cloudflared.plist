<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cloudflare Tunnel "husrevity" — runs on user login, restarts on any exit.

  Install (one-time, after `cloudflared tunnel create husrevity`):
    ln -s "$(pwd)/ops/launchagents/com.iamhusrev.cloudflared.plist" \
      ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.iamhusrev.cloudflared.plist

  Status:
    launchctl list | grep cloudflared
    tail -f ~/Library/Logs/iamhusrev/cloudflared.err.log

  Force restart:
    launchctl kickstart -k gui/$(id -u)/com.iamhusrev.cloudflared

  Uninstall:
    launchctl unload -w ~/Library/LaunchAgents/com.iamhusrev.cloudflared.plist
    rm ~/Library/LaunchAgents/com.iamhusrev.cloudflared.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.iamhusrev.cloudflared</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/cloudflared</string>
        <string>tunnel</string>
        <string>--config</string>
        <string>/Users/husrev/Projects (Personal)/husrevity/ops/cloudflared/config.yml</string>
        <string>run</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- LaunchAgents do NOT inherit the user shell PATH; spell it out. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on every exit (network blips, edge reconnects). -->
    <key>KeepAlive</key>
    <true/>

    <!-- Throttle restart attempts so a permanently broken process doesn't burn CPU. -->
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/Users/husrev/Library/Logs/iamhusrev/cloudflared.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/husrev/Library/Logs/iamhusrev/cloudflared.err.log</string>
</dict>
</plist>
