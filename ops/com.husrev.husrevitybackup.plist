<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    Daily husrevity_nest backup at 03:00 local time.
    Install:
      cp ops/com.husrev.husrevitybackup.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.husrev.husrevitybackup.plist
    Uninstall:
      launchctl unload ~/Library/LaunchAgents/com.husrev.husrevitybackup.plist
      rm ~/Library/LaunchAgents/com.husrev.husrevitybackup.plist
    Manual trigger:
      launchctl start com.husrev.husrevitybackup
  -->
  <dict>
    <key>Label</key>
    <string>com.husrev.husrevitybackup</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/husrev/Projects (Personal)/husrevity/scripts/pg-backup.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/husrev/Library/Logs/husrevity-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/husrev/Library/Logs/husrevity-backup.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
  </dict>
</plist>
